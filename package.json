{
  "name": "autocli",
  "version": "0.1.0",
  "description": "Generate a progressive-disclosure, agent-first CLI from your Convex schema",
  "type": "module",
  "bin": {
    "autocli": "./bin/autocli.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitethanwoo/autocli.git"
  },
  "keywords": [
    "convex",
    "cli",
    "ai-agents",
    "codegen",
    "schema",
    "agent-tools"
  ]
}
